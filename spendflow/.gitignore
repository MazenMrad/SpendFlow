# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# sensitive data
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.log
credentials.json
*.key
*.pem
secrets/
config/keys/
config/credentials/

# opencode
.opencode/

# agent folders
agents/
.agent/
.agents/

